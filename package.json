{
  "name": "@gregroyclark/create-readme",
  "version": "2.0.0-beta.2",
  "description": "Repo-aware CLI that generates polished README files from facts already in your project.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./src/index.js"
  },
  "bin": {
    "create-readme": "bin/create-readme.js"
  },
  "files": [
    "bin",
    "docs",
    "src",
    "index.js",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm test && npm audit --omit=dev",
    "start": "node ./bin/create-readme.js",
    "site:dev": "wrangler pages dev ./site",
    "site:check": "node --test test/site.test.js",
    "site:deploy": "wrangler pages deploy ./site --project-name=create-readme --branch=master"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregroyclark/create-readme.git"
  },
  "bugs": {
    "url": "https://github.com/gregroyclark/create-readme/issues"
  },
  "homepage": "https://createreadme.com",
  "keywords": [
    "cli",
    "documentation",
    "github",
    "markdown",
    "readme"
  ],
  "author": "Greg Clark",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
